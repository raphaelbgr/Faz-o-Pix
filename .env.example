# Faz-o-Pix Environment Configuration
# Copy to .env and update values. Never commit .env!
# Recommended: just use ./dev.sh which sets everything automatically.

# Database (Docker on port 63294)
DATABASE_URL=postgresql://postgres:dev_password_123@localhost:63294/fazopix_dev

# Security (generate strong values for production)
JWT_SECRET=dev_jwt_secret_min_32_chars_long_123456789
COOKIE_SECRET=dev_cookie_secret_min_32_chars_long_123456789
ENCRYPTION_KEY=dev_encryption_key_exactly_32_chars12

# Server
PORT=63292
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:63293
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:63292/api
NEXT_PUBLIC_WS_URL=ws://localhost:63292
NEXT_PORT=63293

# Brazilian config
TIMEZONE=America/Sao_Paulo
LOCALE=pt-BR
PIX_VALIDATION_MODE=strict
