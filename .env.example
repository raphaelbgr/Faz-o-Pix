# =============================================================================
# Faz-o-Pix Environment Configuration
# =============================================================================
# Copy this file to .env and update the values as needed
# IMPORTANT: Never commit .env files to version control!

# =============================================================================
# ENVIRONMENT & MODE
# =============================================================================
# Environment mode: development, staging, production
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION  
# =============================================================================
# Primary database connection string
# Development (Docker): Uses containerized PostgreSQL
DATABASE_URL=postgresql://postgres:dev_password_123@postgres:5432/fazopix_dev

# Development (External): Uses external PostgreSQL server  
# DATABASE_URL=postgresql://postgres:tjq5uxt3@192.168.7.101:5432/fazopix_dev

# Production (Supabase): Uses managed PostgreSQL
# DATABASE_URL=postgresql://postgres:[SUPABASE_DB_PASSWORD]@db.vyikegnaiyzzlnanegjd.supabase.co:5432/postgres


# =============================================================================
# SECURITY KEYS (REQUIRED - GENERATE STRONG VALUES FOR PRODUCTION)
# =============================================================================
# JWT secret for token signing (minimum 32 characters)
JWT_SECRET=dev_jwt_secret_min_32_chars_long_123456789

# Cookie encryption secret (minimum 32 characters)
COOKIE_SECRET=dev_cookie_secret_min_32_chars_long_123456789  

# Encryption key for sensitive data (exactly 32 characters)
ENCRYPTION_KEY=dev_encryption_key_exactly_32_chars12

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server port for the backend API
PORT=3001

# Host binding (0.0.0.0 for Docker, localhost for local dev)
HOST=0.0.0.0

# CORS origin for frontend requests
CORS_ORIGIN=http://localhost:3000

# API rate limiting (requests per minute)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Public API URL accessible from browser
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Public WebSocket URL for real-time features  
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Frontend development port
NEXT_PORT=3000

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log level: error, warn, info, debug
LOG_LEVEL=debug

# Enable structured logging (true/false)
STRUCTURED_LOGS=true

# Enable request logging (true/false) 
REQUEST_LOGGING=true

# =============================================================================
# SUPABASE CONFIGURATION (PRODUCTION)
# =============================================================================
# Supabase project URL
SUPABASE_URL=https://vyikegnaiyzzlnanegjd.supabase.co

# Supabase anonymous key (public, safe to expose)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ5aWtlZ25haXl6emxuYW5lZ2pkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTczNTUwNjcsImV4cCI6MjA3MjkzMTA2N30.es9Rcgij6GSn26u-x-olVSlHJ7_4oTe99x-6xzas4zc

# Supabase service role key (SENSITIVE - DO NOT EXPOSE)  
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
# Health check timeout in milliseconds
HEALTH_CHECK_TIMEOUT=5000

# Database connection timeout in milliseconds
DB_CONNECTION_TIMEOUT=10000


# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Enable hot reload for backend (true/false)
HOT_RELOAD=true

# Enable debug mode (true/false)
DEBUG_MODE=true

# Disable authentication for development (true/false) - USE WITH CAUTION
# DISABLE_AUTH=false

# =============================================================================
# BRAZILIAN SPECIFIC CONFIGURATION
# =============================================================================
# Default timezone for the application
TIMEZONE=America/Sao_Paulo

# Default locale for date/number formatting
LOCALE=pt-BR

# PIX validation strictness (strict/relaxed)
PIX_VALIDATION_MODE=strict