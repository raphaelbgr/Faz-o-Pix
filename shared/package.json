      "types": "./types/index.ts",
      "import": "./types/index.ts",
      "require": "./types/index.ts"
    },
    "./types/common": {
      "types": "./types/common.ts",
      "import": "./types/common.ts",
      "require": "./types/common.ts"
    },
    "./types/api": {
      "types": "./types/api.ts",
      "import": "./types/api.ts",
      "require": "./types/api.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
