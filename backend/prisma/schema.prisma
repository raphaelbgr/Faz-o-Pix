generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentifierType {
  PIX_CPF
  PIX_CNPJ
  PIX_EMAIL
  PIX_PHONE
  PIX_EVP
  EMAIL
  PHONE
}

enum BillRole {
  OWNER
  MEMBER
}

enum ShareType {
  EQUAL
  PERCENT
  SHARES
}

enum SettlementMethod {
  PIX
  CASH
  OTHER
}

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // No relations - tables are independent

  @@map("users")
}

model Identifier {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  type      IdentifierType
  value     String         @unique
  createdAt DateTime       @default(now()) @map("created_at")

  // No foreign key constraint - tables are independent

  @@index([userId])
  @@index([value])
  @@map("identifiers")
}

model Participant {
  id          String   @id @default(uuid())
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  // No relations - tables are independent

  @@map("participants")
}

model ParticipantIdentifier {
  id            String         @id @default(uuid())
  participantId String         @map("participant_id")
  type          IdentifierType
  value         String         @unique
  createdAt     DateTime       @default(now()) @map("created_at")

  // No foreign key constraint - tables are independent

  @@index([participantId])
  @@index([value])
  @@map("participant_identifiers")
}

model UserParticipantLink {
  participantId String @unique @map("participant_id")
  userId        String @unique @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  // No foreign key constraints - tables are independent

  @@id([participantId, userId])
  @@map("users_participants_link")
}

model Bill {
  id            String   @id @default(uuid())
  ownerUserId   String   @map("owner_user_id")
  name          String
  description   String?
  currency      String   @default("BRL")
  simplifyDebts Boolean  @default(true) @map("simplify_debts")
  isArchived    Boolean  @default(false) @map("is_archived")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // No relations - tables are independent

  @@index([ownerUserId])
  @@map("bills")
}

model BillMember {
  id            String   @id @default(uuid())
  billId        String   @map("bill_id")
  participantId String   @map("participant_id")
  role          BillRole @default(MEMBER)
  createdAt     DateTime @default(now()) @map("created_at")

  // No foreign key constraints - tables are independent

  @@unique([billId, participantId])
  @@index([billId])
  @@index([participantId])
  @@map("bill_members")
}

model Expense {
  id                 String   @id @default(uuid())
  billId             String   @map("bill_id")
  payerParticipantId String   @map("payer_participant_id")
  amountCents        Int      @map("amount_cents")
  description        String?
  spentAt            DateTime @map("spent_at")
  createdAt          DateTime @default(now()) @map("created_at")

  // No foreign key constraints - tables are independent

  @@index([billId])
  @@index([payerParticipantId])
  @@map("expenses")
}

model ExpenseSplit {
  id            String    @id @default(uuid())
  expenseId     String    @map("expense_id")
  participantId String    @map("participant_id")
  shareType     ShareType @map("share_type")
  shareValue    Decimal   @map("share_value") @db.Decimal(10, 4)
  amountCents   Int       @map("amount_cents")

  // No foreign key constraints - tables are independent

  @@index([expenseId])
  @@index([participantId])
  @@map("expense_splits")
}

model Settlement {
  id                 String           @id @default(uuid())
  billId             String           @map("bill_id")
  fromParticipantId  String           @map("from_participant_id")
  toParticipantId    String           @map("to_participant_id")
  amountCents        Int              @map("amount_cents")
  method             SettlementMethod
  reference          String?
  note               String?
  createdAt          DateTime         @default(now()) @map("created_at")

  // No foreign key constraints - tables are independent

  @@index([billId])
  @@index([fromParticipantId])
  @@index([toParticipantId])
  @@map("settlements")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // No foreign key constraint - tables are independent

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model BillChangelog {
  id            String   @id @default(uuid())
  billId        String   @map("bill_id")
  userId        String   @map("user_id")
  action        String   // 'EXPENSE_ADDED', 'EXPENSE_UPDATED', 'EXPENSE_DELETED', 'MEMBER_ADDED', 'SETTLEMENT_ADDED'
  entityType    String   @map("entity_type") // 'EXPENSE', 'MEMBER', 'SETTLEMENT'
  entityId      String?  @map("entity_id")
  description   String
  metadata      Json?    // Store additional change details
  createdAt     DateTime @default(now()) @map("created_at")

  // No foreign key constraints - tables are independent

  @@index([billId])
  @@index([userId])
  @@index([createdAt])
  @@map("bill_changelog")
}