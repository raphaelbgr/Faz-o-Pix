{
  "name": "fazopix",
  "version": "1.0.0",
  "description": "Faz-o-Pix - PIX-native expense splitting for Brazilian users",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:shared": "cd shared && npm run dev",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:shared": "cd shared && npm run build",
    "test": "cd backend && npm run test && cd ../frontend && npm run test",
    "test:backend": "cd backend && npm run test",
    "test:frontend": "cd frontend && npm run test",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "typecheck": "cd backend && npm run typecheck && cd ../frontend && npm run typecheck && cd ../shared && npm run typecheck",
    "typecheck:backend": "cd backend && npm run typecheck",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "typecheck:shared": "cd shared && npm run typecheck",
    "db:migrate": "cd backend && npm run prisma:migrate",
    "db:seed": "cd backend && npm run prisma:seed",
    "db:studio": "cd backend && npm run prisma:studio",
    "db:generate": "cd backend && npm run prisma:generate",
    "setup": "npm install && npm run db:generate",
    "clean": "rm -rf node_modules backend/node_modules frontend/node_modules shared/node_modules",
    "clean:build": "rm -rf backend/dist frontend/.next shared/dist",
    "health": "curl -f http://localhost:3001/api/health && curl -f http://localhost:3000"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/faz-o-pix.git"
  },
  "keywords": [
    "pix",
    "expense-splitting",
    "brazilian-fintech",
    "expense-tracker",
    "bill-splitting"
  ],
  "author": "Faz-o-Pix Team",
  "license": "MIT"
}